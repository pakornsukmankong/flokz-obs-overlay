# การ deploy บน Vercel — เชื่อม Vercel KV (Upstash Redis) จาก Storage tab
# แล้ว Vercel จะ inject ตัวแปรพวกนี้ให้อัตโนมัติ (ไม่ต้องกรอกเอง)
#
# ตอน dev ในเครื่อง: ไม่ต้องตั้งอะไร — ระบบจะ fallback ไปเก็บไฟล์ใน ./config เอง
#
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=
